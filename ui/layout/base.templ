package layout

import "github.com/raffy-io/placepicker/ui/components"

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" type="image/x-icon" href="/static/images/logo.png"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script defer src="/static/js/alpine-intersect.min.js"></script>
			<script defer src="/static/js/alpine.min.js"></script>
			<script defer src="/static/js/htmx.min.js"></script>
		</head>
		<body class="bg-app-dom text-app-sec p-5 lg:p-24 ">
			<header class="grid place-items-center">
				<img class="h-16 w-16 mb-4 animate-spin [animation-duration:10s]" src="/static/images/logo.png" alt="placepicker logo"/>
				<h1 class="uppercase text-2xl lg:text-6xl font-semibold tracking-wider">placepicker</h1>
				<p class="lg:w-1/3 mx-auto text-center text-sm">Create your personal collection of places you would like to visit or you have visited</p>
			</header>
			<main>
				{ children... }
			</main>
			@components.ConfirmModal()
		</body>
	</html>
}
