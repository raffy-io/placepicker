package components

templ ConfirmModal() {
	<dialog
		x-data="nativeConfirmModal()"
		x-init="$watch('isOpen', value => value ? $el.showModal() : $el.close())"
		x-show="isOpen"
		x-on:open-confirm.window="open($event)"
		x-on:close="cancel()"
		class="custom-modal p-6 rounded shadow-xl border border-app-acc bg-app-sec text-app-txt fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 backdrop:backdrop-blur-sm backdrop:bg-black/50"
	>
		<form method="dialog" class="flex flex-col gap-4">
			<h3 x-text="title" class="text-xl font-bold capitalize">Confirm Action</h3>
			<p x-text="message" class="text-sm opacity-90"></p>
			<div class="flex justify-end gap-3 mt-4">
				<button type="button" @click="cancel()" class="px-4 py-2 bg-gray-400 rounded text-app-dom cursor-pointer">Cancel</button>
				<button type="button" @click="confirm()" class="px-4 py-2 bg-red-600 rounded text-white cursor-pointer">Proceed</button>
			</div>
		</form>
	</dialog>
	<script>
    function nativeConfirmModal() {
        return {
            isOpen: false,
            title: 'Confirm',
            message: '',
            htmxEvent: null,

            open(e) {
                this.title = e.detail.title || 'Confirm';
                this.message = e.detail.message || 'Are you sure?';
                this.htmxEvent = e.detail.targetEvent;
                this.isOpen = true;
            },
            cancel() {
                this.isOpen = false;
                this.htmxEvent = null;
            },
            confirm() {
                this.isOpen = false;
                if (this.htmxEvent) {
                    this.htmxEvent.detail.confirmed = true;
                    this.htmxEvent.detail.issueRequest();
                }
            }
        }
    }
    </script>
}
